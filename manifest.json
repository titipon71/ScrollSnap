{
  "manifest_version": 3,
  "name": "LongScreenshot - Full Page Capture",
  "version": "1.0.0",
  "description": "แคปหน้าเว็บแบบยาวทั้งหน้า (Full Page Screenshot) อัตโนมัติ พร้อมจัดการ Sticky Header และรองรับ Inner Scroll",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LongScreenshot - แคปหน้าจอยาว",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "start-capture": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "เริ่ม/หยุดแคปหน้าจอยาวทันที"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
